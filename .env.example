# libcore 密钥配置模板
# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会入库）。
# 本文件仅作模板，可安全提交。

# ---- 飞书 IM（UiBridge.attach_feishu 缺省读取）----
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_DOMAIN=feishu          # feishu 国内 / lark 国际

# ---- 其他平台适配器（按需启用，装配层读取同名变量）----
# QQ_APP_ID=
# QQ_CLIENT_SECRET=
# SLACK_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# WECOM_BOT_ID=
# WECOM_SECRET=
# WEIXIN_ACCOUNT_ID=
# WEIXIN_TOKEN=
# YUANBAO_APP_ID=
# YUANBAO_APP_SECRET=
# YUANBAO_BOT_ID=
# DINGTALK_WEBHOOK_URL=

# ---- LLM 后端（openai-completions 协议族 / anthropic / google / bedrock）----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- 可选：覆盖 .env 文件路径（默认项目根/.env）----
# LIBCORE_ENV_FILE=/path/to/.env
